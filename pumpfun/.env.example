# Secrets for docker compose. Copy to .env; .env is gitignored.
# An empty value here does NOT overwrite what is in config.yaml.
PUMPBOT_GROK_API_KEY=xai-...
PUMPBOT_DATA_API_KEY=
PUMPBOT_WALLET_PRIVATE_KEY=
PUMPBOT_RPC_URL=https://api.mainnet-beta.solana.com
PUMPBOT_MODE=dry-run
PUMPBOT_HEALTH_PORT=0
PUMPBOT_ALERT_WEBHOOK=
PUMPBOT_ALERT_FORMAT=
PUMPBOT_TELEGRAM_BOT_TOKEN=
PUMPBOT_TELEGRAM_CHAT_ID=
